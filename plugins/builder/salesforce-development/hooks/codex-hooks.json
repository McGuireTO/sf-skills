{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SF_AGENT_CLIENT=codex \"${PLUGIN_ROOT}\"/scripts/sf-context prompt-dispatch",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py PreToolUse",
            "timeout": 150
          }
        ],
        "matcher": "Bash|apply_patch|Write|Edit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py PostToolUse",
            "timeout": 30
          }
        ],
        "matcher": "Bash|mcp__.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py SessionStart",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|compact"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py SessionEnd",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}\"/scripts/codex_hooks.py Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
